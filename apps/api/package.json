{
  "name": "@opencred/api",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "description": "OpenCred core API: auth, templates, issuance, verification, webhooks, analytics, billing.",
  "main": "dist/main.js",
  "scripts": {
    "//build": "Deliberately does not run `prisma generate`. The generated client only changes when the schema does, it is regenerated by postinstall and by `db:generate`, and on Windows the rename fails outright while a dev server holds the query engine DLL open — turning every rebuild-while-running into a confusing EPERM.",
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "dev:worker": "node dist/worker.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node dist/seed.js",
    "test": "npm run build && node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@opencred/credentials": "1.0.0",
    "@opencred/i18n": "1.0.0",
    "@opencred/renderer": "1.0.0",
    "@opencred/schema": "1.0.0",
    "@opencred/templates": "1.0.0",
    "@opencred/wallet": "1.0.0",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.6",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "express": "^5.0.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
    "playwright-core": "^1.49.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.2.1",
    "typescript": "^5.7.2"
  }
}
