# ---------------------------------------------------------------------------
# OpenCred — environment configuration
#
# Copy to `.env` and adjust. Every value below has a working local default in
# docker-compose.yml, so a fresh clone runs with zero edits.
#
# Community Edition note (FR-ID-04): nothing in this file points at an
# OpenCred-operated service. A self-hosted install has no mandatory outbound
# network dependency beyond the SMTP host you choose to configure.
# ---------------------------------------------------------------------------

# --- Deployment identity ---------------------------------------------------
# cloud    = multi-tenant SaaS (signup creates a new org, billing enforced)
# community = single-organization self-hosted, free, no billing, no metering
# enterprise = self-hosted with the commercial Enterprise module enabled
OPENCRED_EDITION=community
NODE_ENV=development

# Public origins. PUBLIC_URL is what appears inside credentials, QR codes and
# DID documents — it MUST be the externally reachable HTTPS origin in prod.
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
WEB_PORT=3000

# --- Data layer ------------------------------------------------------------
DATABASE_URL=postgresql://opencred:opencred@localhost:5432/opencred?schema=public
VALKEY_URL=redis://localhost:6379

# Published ports for the local docker-compose stack. Change these (and the
# URLs above to match) when your machine already has something on the default.
POSTGRES_PORT=5432
VALKEY_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Secrets ---------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000000000
# Encrypts issuer private keys and per-org SMTP credentials at rest (AES-256-GCM).
ENCRYPTION_KEY=dev-only-insecure-encryption-key-change-me-000000

# --- Object storage --------------------------------------------------------
# driver: local | s3   (s3 covers MinIO and any S3-compatible endpoint)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opencred
S3_ACCESS_KEY_ID=opencred
S3_SECRET_ACCESS_KEY=opencred123
S3_FORCE_PATH_STYLE=true

# --- Email (FR-ISS-07: bring your own provider) ----------------------------
# transport: smtp | log   ("log" prints the message and is the dev default)
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="OpenCred <no-reply@localhost>"

# --- Rendering -------------------------------------------------------------
# Playwright/Chromium powers HTML -> PDF/PNG. When unavailable the renderer
# degrades to deterministic SVG output instead of failing issuance.
RENDER_CONCURRENCY=4
RENDER_TIMEOUT_MS=30000
PLAYWRIGHT_BROWSERS_PATH=

# --- Workers ---------------------------------------------------------------
ISSUANCE_CONCURRENCY=8
WEBHOOK_CONCURRENCY=16

# --- OAuth (FR-ID-01, optional) --------------------------------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common

# --- Wallet passes (FR-STD-04, optional) -----------------------------------
# Both Apple and Google require the operator to enrol with the platform, so
# these are blank by default and the buttons simply do not appear. See
# docs/wallet-passes.md for what to obtain and how.
#
# Google: the numeric issuer id from the Google Wallet console, plus the
# service-account email and private key from its JSON key file. Paste the key
# with its literal \n escapes intact — they are converted on load.
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_CLASS_SUFFIX=opencred_credential
WALLET_GOOGLE_SERVICE_ACCOUNT_EMAIL=
WALLET_GOOGLE_PRIVATE_KEY=
#
# Apple: a Pass Type ID certificate and key in PEM, plus Apple's WWDR
# intermediate. Signing shells out to OpenSSL, because PKCS#7 is not something
# Node's crypto module can produce.
WALLET_APPLE_PASS_TYPE_ID=
WALLET_APPLE_TEAM_ID=
WALLET_APPLE_CERT_PATH=
WALLET_APPLE_KEY_PATH=
WALLET_APPLE_KEY_PASSPHRASE=
WALLET_APPLE_WWDR_PATH=
WALLET_APPLE_OPENSSL_PATH=

# --- Telemetry (opt-in only, off by default) -------------------------------
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=

# --- Billing (Cloud edition only) ------------------------------------------
# Left blank the platform uses the internal ledger-only billing driver, which
# is what Community/Enterprise self-hosted installs use.
BILLING_DRIVER=internal
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
