# OpenCred web image (admin dashboard, verification pages, recipient wallet).

# ---------------------------------------------------------------- builder ----
FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/schema/package.json ./packages/schema/
COPY packages/credentials/package.json ./packages/credentials/
COPY packages/renderer/package.json ./packages/renderer/
COPY packages/templates/package.json ./packages/templates/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY integrations/n8n-nodes-opencred/package.json ./integrations/n8n-nodes-opencred/

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --ignore-scripts

COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web

# The web app imports the compiled shared packages, so they are built first.
RUN npm run build -w @opencred/schema \
 && npm run build -w @opencred/renderer

# NEXT_PUBLIC_* values are inlined at build time. They are supplied as build
# args so an operator's own origins end up in the bundle rather than ours.
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ARG NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_PUBLIC_URL=${NEXT_PUBLIC_PUBLIC_URL} \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build -w @opencred/web

# ---------------------------------------------------------------- runtime ----
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install --no-install-recommends -y ca-certificates tini wget \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# `output: 'standalone'` produces a self-contained server with only the modules
# it actually imports, which is a fraction of the full node_modules tree.
COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /app/apps/web/public ./apps/web/public

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:3000/ || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/web/server.js"]
